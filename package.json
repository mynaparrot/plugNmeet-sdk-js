{
  "name": "plugnmeet-sdk-js",
  "version": "2.2.3",
  "description": "plugNmeet JS SDK",
  "author": "Jibon L. Costa",
  "license": "MIT",
  "repository": "https://github.com/mynaparrot/plugNmeet-sdk-js",
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "oxlint --config=./.oxlintrc.json --fix",
    "lint:check": "oxlint --config=./.oxlintrc.json",
    "format:check": "prettier --check {src,tests}/**/*.{jsx,ts,tsx}",
    "build-docs": "typedoc"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "axios": "1.21.0",
    "form-data": "4.0.6",
    "plugnmeet-protocol-js": "1.6.3-5"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.2.3",
    "@types/node": "26.6.5",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  }
}
